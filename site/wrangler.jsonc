{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mkcmd-site",
  "compatibility_date": "2026-10-08",
  // Also serve on workers.dev, for previews before the custom domain is attached.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "mkcmd.mackenziebowes.com", "custom_domain": true }
  ]
}
